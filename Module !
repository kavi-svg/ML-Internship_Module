# TASK 2: Redefine n1 as [22, 33, 44], order 1x3
n1 = np.array([22, 33, 44])
print(n1)
python
# TASK 3: Addition — add [2, 2, 2] to n1
print(n1 + np.array([2, 2, 2]))
# Expected output: [24, 35, 46]
python
# TASK 4: Subtraction — subtract [2, 3, 4] from n1
print(n1 - np.array([2, 3, 4]))
# Expected output: [20, 30, 40]
python
# TASK 5: Scalar multiplication — n1 * 25
print(n1 * 25)
# Expected output: [550, 825, 1100]
python
# TASK 6: Element-wise multiplication using np.multiply
print(np.multiply(n1, np.array([11, 12, 13])))
